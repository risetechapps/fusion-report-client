{
    "name": "risetechapps/fusion-report-client",
    "description": "Laravel client for the Fusion Report Server — fluent, typed API for report generation.",
    "keywords": [
        "risetechapps",
        "fusion",
        "report",
        "pdf",
        "xlsx"
    ],
    "homepage": "https://github.com/risetechapps/fusion-report-client",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Rise Tech",
            "email": "apps@risetech.com.br",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12",
        "illuminate/http": "^12"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.1",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "RiseTechApps\\FusionReport\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RiseTechApps\\FusionReport\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage-html coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RiseTechApps\\FusionReport\\FusionReportServiceProvider"
            ],
            "aliases": {
                "FusionReport": "RiseTechApps\\FusionReport\\Facades\\FusionReport"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "version": "1.0.0"
}
